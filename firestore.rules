rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yumarisorid@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == resource.data.classId));
      allow list: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Materials
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submissions
    match /submissions/{submissionId} {
      function isValidSubmission(data) {
        return data.userId == request.auth.uid &&
               data.quizId is string &&
               data.score is number;
      }
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == resource.data.classId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == resource.data.classId));
      allow create: if isSignedIn() && isValidSubmission(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Progress
    match /progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
